#!/usr/bin/env python3
"""tt-frontier -- the Transit Frontier Ledger command line.

    tt-frontier generation show TTF-1
    tt-frontier generation list
    tt-frontier calibrate --results control.json --generation TTF-1 [--write]
    tt-frontier run       --generation TTF-1 --model ... --cb-binary ... [--candidate-cb ...]
    tt-frontier compute   --generation TTF-1 --results raw.json --output receipt.json
    tt-frontier report    receipt.json [--format markdown|comment|box] [--output f]
    tt-frontier receipt verify receipt.json [--generation TTF-1]
    tt-frontier ledger show   TTF-1
    tt-frontier ledger append receipt.json [--id pr-000184]
    tt-frontier ledger audit  TTF-1

Every figure any of these prints is computed from raw measurements. Nothing here accepts a
performance number as an argument, and nothing produces an S, M, L or XL.
"""

from __future__ import annotations

import argparse
import json
import re
import statistics
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "eval"))

from frontier import (compute_frontier, load_generation, verify_receipt,   # noqa: E402
                      build_receipt)
from frontier import ledger as ledger_mod                                   # noqa: E402
from frontier import report as report_mod                                   # noqa: E402
from frontier.generations import GenerationError                            # noqa: E402
from frontier.receipt import ReceiptError                                   # noqa: E402
from frontier.compute import ComputeError                                   # noqa: E402
from frontier.aggregate import AggregateError                               # noqa: E402
from frontier.normalize import ObjectiveError                               # noqa: E402

import os

# Resolved relative to this file, so a copy staged by `eval/run_from_base.sh` uses the BASE
# commit's frozen generations -- a TTF-N definition is part of the ruler, and a submission
# that shipped its own would be scoring itself.
GENERATIONS_DIR = Path(os.environ.get("TT_GENERATIONS_DIR") or (REPO / "eval" / "generations"))
# The ledger is the one thing that must NOT come from a staged copy: it is the permanent
# history, it lives in the real repository, and a trusted evaluator writes it outside the
# candidate's reach.
LEDGER_DIR = Path(os.environ.get("TT_LEDGER_DIR") or (REPO / "frontier"))


def resolve_generation(name_or_path):
    candidate = Path(name_or_path)
    if candidate.exists():
        return load_generation(candidate)
    for root in (GENERATIONS_DIR, LEDGER_DIR):
        path = root / str(name_or_path) / "generation.json"
        if path.exists():
            return load_generation(path)
    raise GenerationError(
        f"no generation {name_or_path!r} under {GENERATIONS_DIR} or {LEDGER_DIR}. "
        f"Available: {', '.join(sorted(p.parent.name for p in GENERATIONS_DIR.glob('*/generation.json'))) or 'none'}")


def load_results(path):
    doc = json.loads(Path(path).read_text())
    if isinstance(doc, list):
        return doc, {}
    return doc.get("results", []), doc.get("provenance", {})


# --------------------------------------------------------------------------- generation ---
def _persist_ceilings(generation, bandwidth_gbs, state_bytes_scale=0.5):
    """Per cell: the most a persisting-L2 policy could ever be worth, in throughput.

    `eval/traffic_budget.py` computes this for one arm; here it is asked of every cell, using
    that cell's OWN measured control rate rather than a matrix-wide one. The step time is
    `sequences / aggregate_tps`, which is the tool's own definition: one decode step advances
    every live sequence.

    Returns {} rather than guessing if the pin or the calibration is missing anything -- a
    confident wrong ceiling is worse than none, and this one is generous already (it assumes a
    perfect replacement policy and a bandwidth-bound step).
    """
    sys.path.insert(0, str(REPO / "eval"))
    try:
        import traffic_budget
    except Exception:                                     # noqa: BLE001
        return {}
    pin_path = REPO / "adapters" / "sparkinfer" / "pin.json"
    if not pin_path.exists():
        return {}
    pin = json.loads(pin_path.read_text())
    model = pin.get("model_geometry") or pin.get("model") or {}
    needed = ("recurrent_layers", "lin_state_bytes_per_layer", "lin_conv_state_bytes_per_layer")
    if not all(k in model for k in needed):
        return {}
    out = {}
    for cell in generation.cells:
        match = re.fullmatch(r"ctx(\d+)-c(\d+)", cell)
        bounds = (generation.cell_bounds.get(cell) or {}).get("goodput_tps") or {}
        control = bounds.get("measured_control")
        if not match or not control:
            continue
        sequences = int(match.group(2))
        ms_per_step = 1000.0 * sequences / float(control)
        # The runtime compacts the matrix state to bf16 on its PACKED decode path, so the
        # footprint at concurrency is half what it is at batch 1 -- `bytes_per_layer` 3207168
        # against `bytes_per_layer_at_max` 1634304 in the adapter's own telemetry, and
        # `state_bytes_scale` 0.5 in configs/rtx5090-section44-ceiling.json. Halving it halves
        # the ceiling, so getting this wrong would overstate the room by a factor of two.
        #
        # It is an ASSUMPTION about a cell the generation cannot check: a cell the runtime does
        # not batch keeps the fp32 state and has twice this ceiling. The scale used is printed.
        scale = state_bytes_scale if sequences > 1 else 1.0
        try:
            arm = traffic_budget.arm_ceiling(
                model, sequences, ms_per_step, scale, bandwidth_gbs,
                persisting_l2_bytes=generation.raw.get("_persisting_l2_bytes") or 62914560,
                active_weight_bytes_per_token=model.get("weight_bytes_per_step"))
        except Exception:                                 # noqa: BLE001
            continue
        family = (arm or {}).get("persist_family") or {}
        if family.get("ceiling_pct") is not None:
            out[cell] = {"persist_pct": float(family["ceiling_pct"]),
                         # What ANY mechanism that removed all recurrent traffic could reach.
                         # The gap between the two is the room that is not the persist
                         # family's, and at concurrency it is two orders of magnitude.
                         "traffic_pct": float(arm.get("ceiling_pct", 0.0)),
                         "ms_per_step": ms_per_step,
                         "state_bytes_scale": scale,
                         # Whether the step the ceiling was computed from was actually moving
                         # bytes. Where it was not, the `any mech.` figure is a loose upper
                         # bound and the tool says so rather than letting it look like a target.
                         "bound": ((arm.get("bandwidth_bound_check") or {}).get("bound")),
                         "utilisation": ((arm.get("bandwidth_bound_check") or {})
                                         .get("bandwidth_utilisation"))}
    return out


def cmd_generation(args):
    if args.action == "list":
        found = sorted(GENERATIONS_DIR.glob("*/generation.json"))
        if not found:
            print("no generations")
            return 0
        for path in found:
            generation = load_generation(path)
            print(f"{generation.name:8s} {len(generation.cells):3d} cells  "
                  f"{len(generation.objectives)} objectives  {generation.checksum()[:19]}  "
                  f"{generation.description}")
        return 0

    generation = resolve_generation(args.name)
    print(f"{generation.name}: {generation.description}")
    print(f"  checksum      {generation.checksum()}")
    print(f"  objectives    " + ", ".join(
        f"{o.key} ({o.direction}, 0 at {o.lo:g}, 1 at {o.hi:g})" for o in generation.objectives))
    print(f"  reference     {generation.reference_point}")
    print(f"  cells         {len(generation.cells)}: {', '.join(generation.cells)}")
    print(f"  weights       " + ", ".join(f"{c}={generation.weights[c]:g}"
                                          for c in generation.cells))
    print(f"  aggregation   {generation.aggregation}, cell floor {generation.cell_floor:g}")
    print(f"  repeats       {generation.min_repeats}..{generation.max_repeats} paired")
    print(f"  confidence    {generation.confidence_level:.2f} lower bound > 0, "
          f"{generation.bootstrap_resamples} resamples, seed {generation.bootstrap_seed}")
    print(f"  protected     {', '.join(generation.protected_cells) or 'none'} "
          f"(max regression {generation.protected_max_regression * 100:.1f}%)")
    print(f"  portfolio     <= {generation.max_configurations} configurations; planners "
          f"{', '.join(generation.allowed_planners) or 'any'}")
    print(f"  model         {generation.model}")
    print(f"  runtime       {generation.runtime}")
    print(f"  hardware      {generation.hardware}")

    if getattr(args, "reachable", False):
        # What a contributor is actually up against, per cell, before spending a week: where
        # the control sat, and how far it moved between repeats of ITSELF when the generation
        # was calibrated. A cell whose control spread is larger than any effect this hardware
        # can produce is a cell nobody can win, and it is better to know that from the ruler
        # than from a receipt.
        print()
        print("  what is reachable, per cell (from the frozen calibration):")
        header = f"    {'cell':16s}"
        for objective in generation.objectives:
            header += f"  {objective.key:>14s} {'spread':>9s}"
        print(header)
        unmeasurable = []
        for cell in generation.cells:
            row = f"    {cell:16s}"
            for objective in generation.objectives:
                bounds = (generation.cell_bounds.get(cell) or {}).get(objective.key) or {}
                control = bounds.get("measured_control")
                spread = generation.published_spread(cell, objective.key)
                row += f"  {control if control is None else f'{control:14.2f}'}"
                if spread is None:
                    row += f" {'?':>9s}"
                else:
                    row += f" {spread:8.2f}%"
                    if spread >= 10.0:
                        unmeasurable.append((cell, objective.key, spread))
            print(row)
        # And the other half of "what is reachable": what a persisting-L2 policy could ever be
        # worth in each cell, from the pinned state geometry and that cell's OWN measured
        # control rate. A cell whose control moves further between repeats of itself than the
        # ceiling a perfect policy could ever reach is a cell nobody can measure a win in, and
        # that is worth knowing from the ruler rather than from three days of device time.
        ceilings = _persist_ceilings(generation, args.bandwidth_gbs, args.state_bytes_scale)
        if ceilings:
            print()
            print(f"  persist-family ceiling per cell, against that cell's own goodput spread "
                  f"({args.bandwidth_gbs:g} GB/s, geometry from adapters/sparkinfer/pin.json,")
            print(f"  matrix state scaled by {args.state_bytes_scale:g} above one sequence "
                  f"because the packed decode path compacts it to bf16):")
            print(f"    {'cell':16s} {'persist':>9s} {'any mech.':>10s} {'bw':>5s} "
                  f"{'spread':>9s} {'floor':>8s}   verdict")
            unwinnable, quantised = [], []
            for cell in generation.cells:
                ceiling = ceilings.get(cell)
                spread = generation.published_spread(cell, "goodput_tps")
                if ceiling is None or spread is None:
                    continue
                # A published spread of 0.000% from three repeats is not evidence of a silent
                # cell; it is three repeats that printed the same number. The bench prints
                # aggregate throughput to one decimal, so nothing below half of that last digit
                # can be seen at all -- 0.05 tok/s is 0.22% of a 22.6 tok/s cell and 0.006% of a
                # 909 tok/s one. The measurable floor is whichever is larger.
                control = ((generation.cell_bounds.get(cell) or {}).get("goodput_tps") or {}
                           ).get("measured_control") or 0.0
                resolution = (0.05 / control * 100.0) if control else 0.0
                effective = max(spread, resolution)
                if resolution > spread:
                    quantised.append(cell)
                verdict = "measurable by the persist family"
                if effective >= ceiling["persist_pct"]:
                    unwinnable.append(cell)
                    verdict = ("PERSIST FAMILY UNWINNABLE"
                               + ("; the traffic is there, the cache is not"
                                  if effective < ceiling["traffic_pct"] else "; and so is any"))
                util = ceiling.get("utilisation")
                bw = "?" if util is None else f"{util * 100:.0f}%"
                print(f"    {cell:16s} {ceiling['persist_pct']:8.3f}% "
                      f"{ceiling['traffic_pct']:9.3f}% {bw:>5s} {spread:8.3f}% "
                      f"{effective:7.3f}%   {verdict}")
            if quantised:
                print()
                print(f"  `floor` is the larger of the published spread and what the bench can")
                print(f"  RESOLVE: aggregate throughput is printed to one decimal, so half of that")
                print(f"  last digit is the smallest difference visible at all. For "
                      f"{', '.join(quantised)}")
                print("  that is larger than the spread three repeats happened to produce, and it")
                print("  is the floor a submission actually has to clear.")
            loose = [c for c in generation.cells
                     if (ceilings.get(c) or {}).get("bound") == "loose"]
            if loose:
                print()
                print(f"  `bw` is how much of the peak bandwidth the step actually used, from "
                      f"the checkpoint's")
                print(f"  weight bytes plus the state traffic. {len(loose)} of "
                      f"{len(ceilings)} cells are BELOW the threshold at which")
                print("  a traffic ceiling is tight, so `any mech.` there is a loose upper bound:")
                print("  part of the step is latency and occupancy rather than bytes, and freeing")
                print("  recurrent traffic returns less than its arithmetic share. The `persist`")
                print("  column does not depend on it -- it is 2 x persisting-L2 over the step,")
                print("  and the step time is measured.")
            if unwinnable:
                print()
                print(f"  {len(unwinnable)} of {len(generation.cells)} cells cannot be MEASURED "
                      f"to be won by a persisting-L2 policy: {', '.join(unwinnable)}.")
                print("  The floor there is larger than the ceiling a PERFECT policy could reach,")
                print("  so no admission rule, window shape or hot-set heuristic can produce a")
                print("  result in them that is distinguishable from noise. The `any mech.` column")
                print("  is what removing ALL recurrent traffic would be worth, and where it is")
                print("  far above the spread the traffic is real -- what is missing is somewhere")
                print("  to put it. docs/VERDICT.md section 7 lists what could address it and")
                print("  what each option costs; none of them is a better admission rule.")

        note = (generation.raw.get("_reference") or {}).get("unmeasurable_cells") or {}
        if note:
            print()
            print("  cells this device could not run at calibration, and therefore not in the "
                  "matrix at all:")
            for cell, why in sorted(note.items()):
                print(f"    {cell:16s} {', '.join(why)}")
        if unmeasurable:
            print()
            print("  axes whose CONTROL moved by more than 10% between repeats of itself. No")
            print("  policy can be measured on one of these; a cell decided on one is an")
            print("  artifact, and every receipt says so on its face:")
            for cell, key, spread in unmeasurable:
                print(f"    {cell:16s} {key:16s} {spread:.1f}%")
    return 0


# ---------------------------------------------------------------------------- calibrate ---
def cmd_calibrate(args):
    """Derive frozen normalization bounds from a measured CONTROL run.

    Section 23: bounds are calibrated on real target hardware BEFORE a generation launches,
    and then frozen for its lifetime. This prints the bounds a control run implies and, with
    --write, edits them into the generation -- which is legitimate before launch and is
    exactly what must never happen afterwards, so it refuses a generation that already has
    receipts.
    """
    generation = resolve_generation(args.generation)
    records, _ = load_results(args.results)
    by_cell = {}
    failed = {}
    for record in records:
        if record.get("status", "OK") != "OK":
            failed.setdefault(record["workload_id"], []).append(record.get("status"))
            continue
        by_cell.setdefault(record["workload_id"], []).append(record["metrics"])

    bounds = {}
    for cell, metrics in sorted(by_cell.items()):
        cell_bounds = {}
        for objective in generation.objectives:
            values = [m[objective.key] for m in metrics if objective.key in m]
            if not values:
                continue
            control = statistics.median(values)
            if objective.direction == "max":
                # 0 at zero, 1 at a ceiling no plausible submission reaches. Anchoring the
                # low end at ZERO is what makes a maximized objective's contribution to dF
                # exactly its own ratio -- so this generation's dF stays comparable with every
                # throughput figure this repository has ever published.
                cell_bounds[objective.key] = {"lo": 0.0,
                                              "hi": round(control * args.headroom, 3)}
            else:
                # 0 at the SLO limit, 1 at zero. Headroom against the published SLO is the
                # thing a serving frontier actually trades against throughput.
                cell_bounds[objective.key] = {"lo": round(control * args.slo_multiple, 3),
                                              "hi": 0.0}
            cell_bounds[objective.key]["measured_control"] = round(control, 4)
            # The cell's own run-to-run spread, published rather than implied (spec section
            # 32). A contributor cannot know what effect size is realistically detectable
            # without it, and a cell whose spread exceeds the regression guard's threshold
            # cannot be protected by that guard without rejecting good submissions on noise.
            spread = (max(values) - min(values)) / control * 100.0 if control else 0.0
            cell_bounds[objective.key]["control_spread_pct"] = round(spread, 4)
            cell_bounds[objective.key]["repeats"] = len(values)
        bounds[cell] = cell_bounds

    document = {
        "generation": generation.name,
        "calibrated_from": str(args.results),
        "headroom_multiple": args.headroom,
        "slo_multiple": args.slo_multiple,
        "note": ("Frozen for the lifetime of this generation. `measured_control` is recorded "
                 "so a reader can see where the control sat inside the bounds; it is not used "
                 "in scoring. A maximized objective anchored at lo=0 contributes its own "
                 "ratio to dF, which keeps this generation's numbers comparable with the "
                 "throughput figures in results/."),
        "cell_bounds": bounds,
        # Cells that produced NO usable measurement during calibration. Recorded rather than
        # dropped: "this generation does not declare that cell" and "that cell cannot be run
        # on this hardware" are different facts, and only the second one tells a contributor
        # why the matrix has a hole in it.
        "unmeasurable_cells": {cell: sorted(set(statuses))
                               for cell, statuses in sorted(failed.items())
                               if cell not in bounds},
    }
    text = json.dumps(document, indent=1, sort_keys=True) + "\n"
    if args.write:
        target = GENERATIONS_DIR / generation.name / "reference.json"
        receipts = list((LEDGER_DIR / generation.name / "receipts").glob("*.json"))
        if receipts:
            print(f"!! {generation.name} already has {len(receipts)} receipt(s). Its bounds "
                  f"are frozen: re-calibrating would silently redefine every one of them. "
                  f"Create a new TTF-N instead.", file=sys.stderr)
            return 2
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        print(f"wrote {target}")
    else:
        print(text, end="")
    return 0


# ------------------------------------------------------------------------------ compute ---
def cmd_compute(args):
    generation = resolve_generation(args.generation)
    records, provenance = load_results(args.results)
    computation = compute_frontier(generation, records, allow_partial=args.allow_partial)

    correctness = args.correctness or provenance.get("correctness", {}).get("correctness") \
        or "PASS"
    receipt = build_receipt(
        generation=generation, computation=computation, correctness=correctness,
        provenance={**provenance, "correctness_method":
                    provenance.get("correctness", {}).get("method",
                                                          "greedy replay, token-exact")},
        pr=args.pr, supersedes=args.supersedes, reason=args.supersede_reason)

    if args.output:
        Path(args.output).write_text(json.dumps(receipt, indent=1, sort_keys=True) + "\n")
        print(f"wrote {args.output}", file=sys.stderr)
    else:
        print(json.dumps(receipt, indent=1, sort_keys=True))
    print(report_mod.receipt_box(receipt), file=sys.stderr)
    return 0 if receipt["status"] in ("FRONTIER_GAIN", "NO_FRONTIER_GAIN") else 1


# -------------------------------------------------------------------------------- probe ---
def cmd_probe(args):
    """Attribute the cells a candidate lost to a serving guard, on an existing raw file.

    `tt-frontier run` does this automatically. This is the same operation for a matrix measured
    before it existed, or one where the probe was skipped -- and it is the same code, so an
    attribution produced here and one produced inline are the same thing.
    """
    from frontier import runner as runner_mod

    generation = resolve_generation(args.generation)
    document = json.loads(Path(args.results).read_text())
    records = document["results"]
    cells = args.cells.split(",") if args.cells else generation.cells

    needs = runner_mod.cells_needing_attribution(records, cells)
    if not needs:
        print("no cell was lost to a serving guard in every repeat; nothing to attribute",
              file=sys.stderr)
        return 0
    print(f">> probing {len(needs)} cell(s): {', '.join(needs)}", file=sys.stderr, flush=True)
    verdicts = runner_mod.attribute_serving_losses(
        cells=needs, model=args.model, baseline_cb_binary=args.cb_binary,
        max_new=args.max_new, long_prefill=args.long_prefill,
        settle_seconds=args.settle_seconds, verbose=not args.quiet,
        scaling=runner_mod.concurrency_scaling(records, cells))
    stamped = runner_mod.apply_attribution(records, verdicts)

    provenance = document.setdefault("provenance", {})
    provenance["attribution"] = {"probed": sorted(verdicts), "verdicts": verdicts,
                                 "probe_binary": args.cb_binary, "skipped": False}
    out = args.output or args.results
    Path(out).write_text(json.dumps(document, indent=1, sort_keys=True) + "\n")
    for cell, found in sorted(verdicts.items()):
        print(f"   {cell}: {found['verdict']} (probe {found['probe_status']})", file=sys.stderr)
    print(f"stamped {stamped} record(s); wrote {out}", file=sys.stderr)
    return 0


# ------------------------------------------------------------------------------- report ---
def cmd_report(args):
    receipt = json.loads(Path(args.receipt).read_text())
    renderers = {"markdown": report_mod.markdown,
                 "comment": report_mod.pr_comment,
                 "box": report_mod.receipt_box,
                 "map": report_mod.contribution_map}
    text = renderers[args.format](receipt)
    if not text.endswith("\n"):
        text += "\n"
    if args.output:
        Path(args.output).write_text(text)
        print(f"wrote {args.output}", file=sys.stderr)
    else:
        sys.stdout.write(text)
    return 0


# ------------------------------------------------------------------------------ receipt ---
def cmd_receipt(args):
    receipt = json.loads(Path(args.receipt).read_text())
    generation = resolve_generation(args.generation) if args.generation else None
    try:
        result = verify_receipt(receipt, generation)
    except ReceiptError as exc:
        print(f"INVALID: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=1))
    return 0


# ------------------------------------------------------------------------------- ledger ---
def cmd_ledger(args):
    if args.action == "show":
        document = ledger_mod.show(LEDGER_DIR, args.name)
        print(f"{document['generation']}: "
              f"{document['compounded_expansion_percent']:+.4f}% compounded over "
              f"{document['verified_frontier_receipts']} verified receipt(s) of "
              f"{document['canonical_receipts']}")
        for entry in document["history"]:
            print(f"  {entry['receipt']:<20s} {entry['status']:<24s} "
                  f"measured {entry['gain_percent']:+8.4f}%  "
                  f"credited {entry['verified_gain_percent']:+8.4f}%  "
                  f"{entry['timestamp_utc']}")
        return 0
    if args.action == "append":
        receipt = json.loads(Path(args.receipt).read_text())
        generation = resolve_generation(receipt["benchmark_generation"])
        path = ledger_mod.append_receipt(LEDGER_DIR, receipt, receipt_id=args.id,
                                         generation=generation)
        print(f"appended {path}")
        return 0
    if args.action == "audit":
        try:
            generation = resolve_generation(args.name)
        except GenerationError:
            generation = None
        result = ledger_mod.audit(LEDGER_DIR, args.name, generation)
        print(json.dumps(result, indent=1))
        return 0 if result["ok"] else 1
    return 2


# ---------------------------------------------------------------------------------- run ---
def cmd_run(args):
    from frontier import runner as runner_mod

    generation = resolve_generation(args.generation)
    cells = args.cells.split(",") if args.cells else generation.cells
    unknown = [c for c in cells if c not in generation.weights]
    if unknown:
        print(f"!! cells not declared by {generation.name}: {unknown}", file=sys.stderr)
        return 2

    def parse_configs(specs, variant):
        configs = []
        for spec in specs or []:
            config_id, _, env_text = spec.partition("=")
            if not config_id:
                raise SystemExit(f"--{variant}-config needs <id>=<KEY=VALUE,...>")
            env = {}
            for pair in filter(None, env_text.split(",")):
                key, _, value = pair.partition("=")
                env[key] = value
            configs.append({"config_id": config_id, "env": env,
                            # Not `bool(env)`: the `baseline` arm sets an environment and
                            # applies no policy ON PURPOSE, and it is how the hook's own cost
                            # is measured. See runner.declares_a_policy.
                            "expect_policy": runner_mod.declares_a_policy(env)})
        return configs

    main_configs = parse_configs(args.main_config, "main") or [
        {"config_id": "control", "env": {}, "expect_policy": False}]
    candidate_configs = parse_configs(args.candidate_config, "candidate")
    if not candidate_configs:
        print("!! at least one --candidate-config is required", file=sys.stderr)
        return 2
    for config in candidate_configs:
        config["env"].setdefault("RECURLOCAL_STATS", "1")

    variants = {
        "main": {"cb_binary": args.cb_binary, "configs": main_configs},
        "candidate": {"cb_binary": args.candidate_cb or args.cb_binary,
                      "configs": candidate_configs},
    }

    correctness = {"correctness": "SKIPPED"}
    if args.generate:
        prompt_ids = [int(t) for t in args.gate_prompt.split(",")]
        correctness = runner_mod.correctness_gate(
            args.generate, args.model, prompt_ids=prompt_ids, gate_tokens=args.gate_tokens,
            control_env={}, candidate_envs=[(c["config_id"], c["env"])
                                            for c in candidate_configs],
            replays=args.gate_control_replays,
            baseline_generate=args.baseline_generate)
        print(f">> correctness: {correctness['correctness']}", file=sys.stderr)

    records = runner_mod.run_matrix(
        generation=generation, cells=cells, model=args.model, variants=variants,
        repeats=args.repeats, max_new=args.max_new, long_prefill=args.long_prefill,
        settle_seconds=args.settle_seconds, verbose=not args.quiet)

    # Attribution. A candidate that lost every repeat of a cell to a SERVING guard, where main
    # produced points, is charged the generation's floor for that cell -- and one floor-decided
    # cell moves dF further than any policy in this repository ever has. Before that is
    # believed, the same cell is run once more on the BASELINE binary with the hook installed
    # and no window. A collapse there is the runtime's, not the submission's.
    attribution = {}
    if not args.no_attribution:
        needs = runner_mod.cells_needing_attribution(records, cells)
        if needs:
            print(f">> attribution probe for {len(needs)} cell(s) the candidate lost: "
                  f"{', '.join(needs)}", file=sys.stderr, flush=True)
            attribution = runner_mod.attribute_serving_losses(
                cells=needs, model=args.model, baseline_cb_binary=args.cb_binary,
                max_new=args.max_new, long_prefill=args.long_prefill,
                settle_seconds=args.settle_seconds, verbose=not args.quiet,
                scaling=runner_mod.concurrency_scaling(records, cells))
        runner_mod.apply_attribution(records, attribution)

    provenance = {
        "baseline_commit": args.baseline_commit,
        "candidate_commit": args.candidate_commit,
        "evaluator_commit": args.evaluator_commit,
        "hardware": {"gpu": args.gpu, "count": 1},
        "runtime": {"name": "SparkInfer", "commit": args.runtime_commit},
        "model": {"name": args.model_name or Path(args.model).name, "digest": args.model_digest},
        "environment_fingerprint": args.environment_fingerprint,
        "correctness": correctness,
        "attribution": {
            "probed": sorted(attribution),
            "verdicts": attribution,
            # True only when the probe ran a binary the candidate did not build. In the
            # same-binary A/B a contributor runs locally these are one file, and the probe
            # then answers the weaker question -- which the receipt has to say rather than
            # imply.
            "probe_independent_of_candidate": bool(args.candidate_cb
                                                   and args.candidate_cb != args.cb_binary),
            "skipped": bool(args.no_attribution),
        },
        "main_concurrency_scaling": runner_mod.concurrency_scaling(records, cells),
        "cells_requested": cells,
        "mode": args.mode,
        "instances": (generation.raw.get("hidden") or {}).get("mode", "unspecified"),
        "repeats": args.repeats,
        "max_new": args.max_new,
        "long_prefill": args.long_prefill,
    }
    runner_mod.write_raw(args.output, records, provenance)
    print(f"wrote {args.output}", file=sys.stderr)
    print(f"score it: tools/tt-frontier compute --generation {generation.name} "
          f"--results {args.output} --output receipt.json", file=sys.stderr)
    return 0


# ------------------------------------------------------------------------------ measure ---
def cmd_measure(args):
    """One variant, over the generation's cells. Calibration and local iteration.

    A contributor runs this against their own build to see what their configuration does
    before asking for an authoritative paired evaluation; the operator runs it once, on a
    control, to CALIBRATE the generation's frozen bounds before it launches.
    """
    from frontier import runner as runner_mod

    generation = resolve_generation(args.generation)
    cells = args.cells.split(",") if args.cells else generation.cells
    env = {}
    for pair in filter(None, (args.env or "").split(",")):
        key, _, value = pair.partition("=")
        env[key] = value
    if env:
        env.setdefault("RECURLOCAL_STATS", "1")

    records = []
    for repeat in range(1, args.repeats + 1):
        for cell in cells:
            if args.settle_seconds:
                import time
                time.sleep(args.settle_seconds)
            label = f"{args.variant}/{args.config_id}/{cell}/r{repeat}"
            print(f">> {label}", file=sys.stderr, flush=True)
            metrics, status, detail = runner_mod.measure_cell(
                args.cb_binary, args.model, cell, env, label,
                max_new=args.max_new, long_prefill=args.long_prefill,
                expect_policy=(runner_mod.declares_a_policy(env)
                               if args.expect_policy == "auto"
                               else args.expect_policy == "yes"),
                verbose=not args.quiet)
            records.append({
                "result_schema_version": runner_mod.RESULT_SCHEMA_VERSION,
                "generation": generation.name, "workload_id": cell,
                "variant": args.variant, "config_id": args.config_id, "repeat": repeat,
                "metrics": metrics, "status": status, "correctness": "PASS",
                "detail": detail,
            })
            print(f"   goodput={metrics.get('goodput_tps', 0):.1f} "
                  f"p99_itl={metrics.get('p99_itl_ms', 0):.2f} [{status}]",
                  file=sys.stderr, flush=True)

    runner_mod.write_raw(args.output, records,
                         {"variant": args.variant, "config_id": args.config_id, "env": env,
                          "model": {"name": Path(args.model).name},
                          "cells_requested": cells, "repeats": args.repeats})
    print(f"wrote {args.output}", file=sys.stderr)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tt-frontier", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("generation", help="inspect a frozen TTF-N definition")
    p.add_argument("action", choices=["show", "list"])
    p.add_argument("name", nargs="?", default="TTF-1")
    p.add_argument("--bandwidth-gbs", type=float, default=1792.0,
                   help="device memory bandwidth for the per-cell ceiling (default 1792, the "
                        "RTX 5090's). Named rather than assumed: the ceiling is a share of what "
                        "the step moves, and that denominator is bandwidth times step time.")
    p.add_argument("--state-bytes-scale", type=float, default=0.5,
                   help="matrix-state size at concurrency relative to batch 1 (default 0.5: the "
                        "packed decode path compacts fp32 to bf16). A cell the runtime does NOT "
                        "batch keeps the fp32 state and has twice the ceiling printed.")
    p.add_argument("--reachable", action="store_true",
                   help="per cell: where the control sat and how far it moved between repeats "
                        "of itself at calibration. Read it before spending a week: an axis "
                        "whose control spread exceeds anything the hardware can produce is a "
                        "cell nobody can win.")
    p.set_defaults(func=cmd_generation)

    p = sub.add_parser("calibrate", help="derive frozen bounds from a measured control run")
    p.add_argument("--generation", default="TTF-1")
    p.add_argument("--results", required=True)
    p.add_argument("--headroom", type=float, default=4.0,
                   help="a maximized objective normalizes to 1 at this multiple of the "
                        "measured control, so no plausible submission clips (default 4)")
    p.add_argument("--slo-multiple", type=float, default=3.0,
                   help="a minimized objective normalizes to 0 at this multiple of the "
                        "measured control: the generation's SLO limit (default 3)")
    p.add_argument("--write", action="store_true")
    p.set_defaults(func=cmd_calibrate)

    p = sub.add_parser("probe", help="attribute cells a candidate lost to a serving guard")
    p.add_argument("--generation", default="TTF-1")
    p.add_argument("--results", required=True, help="a raw result file, stamped in place")
    p.add_argument("--output", help="write here instead of overwriting --results")
    p.add_argument("--model", required=True)
    p.add_argument("--cb-binary", required=True,
                   help="the BASELINE build's cb bench. Not the candidate's: a candidate that "
                        "could make its own probe fail would get a cell it lost dropped rather "
                        "than scored, which is strictly to its advantage.")
    p.add_argument("--cells", help="comma-separated subset to consider")
    p.add_argument("--max-new", type=int, default=64)
    p.add_argument("--long-prefill", type=int, default=4096)
    p.add_argument("--settle-seconds", type=int, default=30)
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_probe)

    p = sub.add_parser("compute", help="raw results -> Frontier Receipt")
    p.add_argument("--generation", default="TTF-1")
    p.add_argument("--results", required=True)
    p.add_argument("--output")
    p.add_argument("--pr", type=int)
    p.add_argument("--correctness", choices=["PASS", "FAIL", "BUILD_FAIL", "UNSCORABLE"])
    p.add_argument("--allow-partial", action="store_true",
                   help="score a matrix with cells missing. The receipt says PARTIAL on its "
                        "face; a partial matrix is not a full-coverage contribution.")
    p.add_argument("--supersedes", nargs="*")
    p.add_argument("--supersede-reason")
    p.set_defaults(func=cmd_compute)

    p = sub.add_parser("report", help="receipt -> Markdown, PR comment, or the terminal box")
    p.add_argument("receipt")
    p.add_argument("--format", choices=["markdown", "comment", "box", "map"],
                   default="markdown")
    p.add_argument("--output")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("receipt", help="verify a receipt against itself and its generation")
    p.add_argument("action", choices=["verify"])
    p.add_argument("receipt")
    p.add_argument("--generation")
    p.set_defaults(func=cmd_receipt)

    p = sub.add_parser("ledger", help="the append-only receipt history")
    p.add_argument("action", choices=["show", "append", "audit"])
    p.add_argument("name", nargs="?", default="TTF-1")
    p.add_argument("--receipt")
    p.add_argument("--id")
    p.set_defaults(func=cmd_ledger)

    p = sub.add_parser("measure", help="one variant over the cells: calibration, or local iteration")
    p.add_argument("--generation", default="TTF-1")
    p.add_argument("--model", required=True)
    p.add_argument("--cb-binary", required=True)
    p.add_argument("--config-id", default="control")
    p.add_argument("--variant", choices=["main", "candidate"], default="main")
    p.add_argument("--env", default="", metavar="K=V,K=V")
    p.add_argument("--expect-policy", choices=["auto", "yes", "no"], default="auto",
                   help="whether this configuration must deliver a policy. `auto` reads it "
                        "from the environment, which is right for every arm including the "
                        "baseline one.")
    p.add_argument("--cells")
    p.add_argument("--repeats", type=int, default=3)
    p.add_argument("--max-new", type=int, default=64)
    p.add_argument("--long-prefill", type=int, default=4096)
    p.add_argument("--settle-seconds", type=int, default=30)
    p.add_argument("--output", default="frontier-measure.json")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_measure)

    p = sub.add_parser("run", help="paired interleaved GPU run of a whole generation")
    p.add_argument("--generation", default="TTF-1")
    p.add_argument("--model", required=True)
    p.add_argument("--cb-binary", required=True, help="qwen3_gguf_cb_bench for main")
    p.add_argument("--candidate-cb", help="the candidate build's cb bench; defaults to "
                                          "--cb-binary, which is the same-binary A/B")
    p.add_argument("--generate", help="the CANDIDATE build's qwen3_gguf_generate, for the "
                                      "token-exact gate")
    p.add_argument("--baseline-generate",
                   help="the BASELINE build's qwen3_gguf_generate. Passing it makes the gate a "
                        "check on the SUBMISSION -- 'this candidate does not change the "
                        "model's output' -- instead of only on the policy. Without it the "
                        "control replays run the candidate's own binary, so a candidate whose "
                        "INERT path changed the output would be compared against its own "
                        "changed output and pass. The receipt records which question was "
                        "answered.")
    p.add_argument("--main-config", action="append", metavar="ID=K=V,K=V")
    p.add_argument("--candidate-config", action="append", metavar="ID=K=V,K=V")
    p.add_argument("--cells", help="comma-separated subset, for local iteration")
    p.add_argument("--repeats", type=int, default=3)
    p.add_argument("--max-new", type=int, default=64)
    p.add_argument("--long-prefill", type=int, default=4096)
    p.add_argument("--settle-seconds", type=int, default=30)
    p.add_argument("--no-attribution", action="store_true",
                   help="skip the baseline probe for cells the candidate lost to a serving "
                        "guard. Every such loss then stays charged to the candidate, which is "
                        "the conservative direction -- and the receipt says the probe was "
                        "skipped rather than that it came back clean.")
    p.add_argument("--gate-tokens", type=int, default=64)
    p.add_argument("--gate-prompt", default="9707,3837,1879,13,25001,752,911")
    p.add_argument("--gate-control-replays", type=int, default=3)
    p.add_argument("--output", default="frontier-raw.json")
    p.add_argument("--baseline-commit")
    p.add_argument("--candidate-commit")
    p.add_argument("--evaluator-commit")
    p.add_argument("--runtime-commit")
    p.add_argument("--model-name")
    p.add_argument("--model-digest")
    p.add_argument("--environment-fingerprint")
    p.add_argument("--gpu", default="RTX 5090")
    p.add_argument("--mode", choices=["public", "authoritative"], default="authoritative",
                   help="`public` is a contributor iterating locally on the published "
                        "instances; `authoritative` is the trusted evaluator's run. Recorded "
                        "in the receipt. TTF-1's instances are public either way and the "
                        "generation says why -- the pinned bench synthesizes its prompts from "
                        "a length parameter, so there is nothing to hide.")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_run)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except (GenerationError, ReceiptError, ComputeError, AggregateError,
            ObjectiveError, ledger_mod.LedgerError) as exc:
        print(f"!! {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
