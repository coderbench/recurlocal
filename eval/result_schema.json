{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gittensor-ai-lab/recurlocal/eval/result_schema.json",
  "title": "RecurLocal synthetic feasibility eval result",
  "description": "Shape of eval-result.json as produced by eval/run_eval.py. Synthetic locality signal only; it is never a model-serving claim.",
  "type": "object",
  "required": [
    "schema_version",
    "correctness",
    "repeats",
    "environment",
    "results",
    "timing_ms",
    "speedup_vs_baseline",
    "best_mode",
    "best_synthetic_gain_pct",
    "stability",
    "interpretation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "correctness": {
      "description": "pass only when every run of every mode produced the same final-state checksum",
      "enum": [
        "pass"
      ]
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "results": {
      "description": "the median-timed run of each mode, verbatim from the benchmark",
      "type": "object",
      "required": [
        "baseline",
        "persist",
        "prefetch",
        "combined"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/benchRun"
        },
        "persist": {
          "$ref": "#/$defs/benchRun"
        },
        "prefetch": {
          "$ref": "#/$defs/benchRun"
        },
        "combined": {
          "$ref": "#/$defs/benchRun"
        }
      }
    },
    "timing_ms": {
      "type": "object",
      "required": [
        "baseline",
        "persist",
        "prefetch",
        "combined"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/timing"
        },
        "persist": {
          "$ref": "#/$defs/timing"
        },
        "prefetch": {
          "$ref": "#/$defs/timing"
        },
        "combined": {
          "$ref": "#/$defs/timing"
        }
      }
    },
    "speedup_vs_baseline": {
      "description": "median baseline elapsed_ms divided by median mode elapsed_ms",
      "type": "object",
      "required": [
        "baseline",
        "persist",
        "prefetch",
        "combined"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "persist": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prefetch": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "combined": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "best_mode": {
      "enum": [
        "persist",
        "prefetch",
        "combined"
      ]
    },
    "best_synthetic_gain_pct": {
      "type": "number"
    },
    "stability": {
      "type": "object",
      "required": [
        "threshold_pct",
        "max_rel_spread_pct",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "threshold_pct": {
          "type": "number",
          "minimum": 0
        },
        "max_rel_spread_pct": {
          "type": "number",
          "minimum": 0
        },
        "verdict": {
          "description": "unstable means run-to-run spread is wider than the difference being measured",
          "enum": [
            "stable",
            "unstable"
          ]
        }
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "description": "what produced this result; a timing without its device, driver and commit cannot be reproduced or compared later",
      "type": "object",
      "required": [
        "timestamp_utc",
        "recurlocal_commit",
        "recurlocal_dirty",
        "benchmark_args",
        "gpu",
        "compute_capability",
        "sm_count",
        "driver_version",
        "runtime_version",
        "clocks_pinned",
        "pinned_clock_mhz",
        "observed_clock_mhz"
      ],
      "additionalProperties": false,
      "properties": {
        "timestamp_utc": {
          "type": "string"
        },
        "recurlocal_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "recurlocal_dirty": {
          "description": "true means the tree had uncommitted changes, so the commit does not identify the code that ran",
          "type": [
            "boolean",
            "null"
          ]
        },
        "benchmark_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "compute_capability": {
          "type": [
            "string",
            "null"
          ]
        },
        "sm_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "driver_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "runtime_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "clocks_pinned": {
          "type": "boolean"
        },
        "pinned_clock_mhz": {
          "type": [
            "integer",
            "null"
          ]
        },
        "observed_clock_mhz": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "min",
            "median",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer"
            },
            "median": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "benchRun": {
      "type": "object",
      "required": [
        "mode",
        "gpu",
        "layers",
        "state_bytes_per_layer",
        "total_state_bytes",
        "tokens",
        "warmup_tokens",
        "elapsed_ms",
        "ms_per_token",
        "layer_updates_per_s",
        "l2_bytes",
        "persisting_l2_max_bytes",
        "access_policy_max_window_bytes",
        "actual_l2_set_aside_bytes",
        "checksum",
        "compute_capability",
        "sm_count",
        "driver_version",
        "runtime_version",
        "windows_applied",
        "windows_deferred_to_caller",
        "hot_set_oversubscribed",
        "pre_touch_launches",
        "pre_touch_bytes",
        "prefetch_distance",
        "pre_touch_strategy",
        "sequences",
        "stream_bytes",
        "hot_set_policy",
        "prefetch_schedule",
        "prefetch_impl",
        "state_layout",
        "qos",
        "stream_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "baseline",
            "persist",
            "prefetch",
            "combined"
          ]
        },
        "gpu": {
          "type": "string"
        },
        "layers": {
          "type": "integer",
          "minimum": 1
        },
        "state_bytes_per_layer": {
          "type": "integer",
          "minimum": 4
        },
        "total_state_bytes": {
          "type": "integer",
          "minimum": 4
        },
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ms_per_token": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layer_updates_per_s": {
          "type": "number",
          "minimum": 0
        },
        "l2_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "persisting_l2_max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "access_policy_max_window_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "actual_l2_set_aside_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "number"
        },
        "compute_capability": {
          "type": "string"
        },
        "sm_count": {
          "type": "integer",
          "minimum": 1
        },
        "driver_version": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_version": {
          "type": "integer",
          "minimum": 0
        },
        "windows_applied": {
          "type": "integer",
          "minimum": 0
        },
        "windows_deferred_to_caller": {
          "type": "integer",
          "minimum": 0,
          "description": "layers where CUDA graph capture was active, so the window was handed to the caller to attach to its kernel node instead of being set on the stream"
        },
        "hot_set_oversubscribed": {
          "type": "integer",
          "minimum": 0,
          "description": "layers where the requested hot set exceeded the L2 budget and the hit ratio was cut"
        },
        "pre_touch_launches": {
          "type": "integer",
          "minimum": 0
        },
        "pre_touch_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "prefetch_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "pre_touch_strategy": {
          "type": "string"
        },
        "sequences": {
          "type": "integer",
          "minimum": 1
        },
        "stream_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "hot_set_policy": {
          "type": "string"
        },
        "prefetch_schedule": {
          "type": "string"
        },
        "prefetch_impl": {
          "enum": [
            "stream",
            "fused"
          ]
        },
        "state_layout": {
          "type": "string"
        },
        "qos": {
          "type": "boolean"
        },
        "stream_mode": {
          "enum": [
            "reuse",
            "distinct"
          ]
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "samples",
        "min",
        "median",
        "max",
        "mean",
        "stdev",
        "rel_spread_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "median": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mean": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stdev": {
          "type": "number",
          "minimum": 0
        },
        "rel_spread_pct": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
