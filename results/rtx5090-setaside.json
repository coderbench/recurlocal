    "driver": "595.84",
    "cuda": "13.3",
    "model": "/root/models/qwen36-moe/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf",
    "runtime_repository": "https://github.com/gittensor-ai-lab/sparkinfer",
    "runtime_commit": "5347b27cbc43af7281d2ac7b30f41d610514d8f3",
    "note": "One box for every arm; graphics clocks cannot be pinned in this container, so only same-run interleaved deltas are trustworthy. Runs 1-3 span two rebuilds of the library, which is why the between-run drift is reported alongside each run's own noise floor rather than averaged away.",
    "candidate_common_env": {
      "RECURLOCAL": "persist",
      "RECURLOCAL_WINDOW_ATTACH": "capture_node",
      "RECURLOCAL_HOT_SET_MODEL": "token_footprint"
    },
    "concurrency_extra_env": {
      "SPARKINFER_PACKED_MAX_ROWS": "8"
    }
  },
  "what_changed_between_runs": {
    "run1": "FitFootprint/Residency sized from the TOKEN footprint (every sequence), so both reserved the whole 60 MiB at four sequences.",
    "run2": "Sized from the WINDOWED footprint (one sequence) -- a persisting window is an address range and this library places one per layer over row 0's slice, so set-aside beyond one sequence's footprint holds nothing. No settling, so the reservation alternated with the packed/unpacked geometry.",
    "run3": "A target must now hold for eight consecutive declarations before it is acted on, so the reservation latches once instead of being re-carved several times a second. At four sequences it latches at 60 MiB during the opening unpacked tokens and holds there."
  },
