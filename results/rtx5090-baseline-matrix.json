  "how_to_reproduce": {
    "build": "integrations/sparkinfer/build.sh $WORK",
    "sweep": "eval/real_sweep.py --binary <cb_bench> --model $MODEL --axis mode --concurrency <N> --repeats 3 --fixed RECURLOCAL_STATS=1 RECURLOCAL_WINDOW_ATTACH=capture_node",
    "why_capture_node": "Production decode is a captured CUDA graph and a stream access-policy window is host-side state capture does not record. With the default attach the persist family computes windows, defers all of them, and reaches no kernel - real_sweep.py refuses that arm by name, and the sweep dies before writing anything."
