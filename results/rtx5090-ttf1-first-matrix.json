 },
 "findings": [
  {
   "finding": "Four of ten cells cannot be measured as concurrency cells on this runtime.",
   "detail": "`ctx4096-c4`, `ctx4096-c16`, `ctx4096-c32` and `ctx16384-c4` lost every candidate repeat to RUNTIME FELL OFF THE BATCHED DECODE PATH -- 0 of 266 tokens packed, max_rows_seen 0. The control looked fine at all four because the control is unhooked and emits no packing telemetry. Its own scaling settles it: 1.15x for four concurrent sequences at ctx4096-c4 against 3.20x at ctx128-c4, 2.61x for sixteen against 8.17x, 3.23x for thirty-two against 13.05x. A cell that returns 1.15x for four sequences was not serving four sequences in either arm."
  },
  {
   "finding": "Charged to the candidate, those four cells cost -99.5%.",
   "detail": "A cell with no operating point is scored at the generation's cell_floor, and five floored cells carry the whole matrix through a geometric mean. The evaluator now probes such a cell on the BASELINE binary with the hook installed and no window before charging it, and a failure that reproduces there leaves the cell unscored and the receipt PARTIAL -- which credits nothing, so a drop cannot pay."
  },
  {
   "finding": "One more cell was decided at the floor on an axis the generation says is unmeasurable.",
   "detail": "`ctx128-c32` reached the floor on a p99 change of 183% against a control spread that reference.json froze at 481% at calibration. Its p50 and p95 are identical to the control's in every repeat (18.7 / 18.9 ms against 18.5 / 18.7); what differs is the extreme tail, where the candidate's maximum was three to five times LOWER (134-239 ms against 670) and its 99th percentile three to five times higher. Both readings are true and neither resolves."
  },
  {
   "finding": "On the six cells that do batch, the shipped default policy is a regression.",
   "detail": "goodput: -0.289% at ctx128-c1, -0.361% at ctx128-c4, -0.179% at ctx4096-c1, -0.388% at ctx128-c16, -1.128% at ctx128-c32, 0.000% at ctx16384-c1. The first three resolve against those cells' published control spreads; the last three do not."
  },
  {
   "finding": "The same arm measured twice on the same box, two hours apart, changed sign.",
   "detail": "At ctx128-c16 the arms sweep measured `recurrent_v0` at +0.071% and this matrix measures the same policy under the name `persist` at -0.388%. The gap is 0.46% and the cell's published control spread is 0.42%. Whatever either run's own within-session floor says, an effect of that size at that cell is not resolved between sessions -- which is why docs/VERDICT.md no longer reports the +0.389% per-cell figure as resolved."
  }
 ],
 "how_to_reproduce": {
  "command": "tools/tt-frontier run --generation TTF-1 --model <checkpoint> --cb-binary <qwen3_gguf_cb_bench> --generate <qwen3_gguf_generate> --repeats 3 --main-config 'control=' --candidate-config 'persist=TENSORTRANSIT=persist,TENSORTRANSIT_WINDOW_ATTACH=capture_node' --output raw.json && tools/tt-frontier compute --generation TTF-1 --results raw.json --output receipt.json",
  "note": "Every figure in this file is computed from the raw results by the tool, not typed. The receipt embedded above is the tool's output verbatim."
 }
}
