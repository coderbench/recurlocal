 "main_concurrency_scaling": {
  "what_this_is": "How much throughput the CONTROL got for the concurrency it asked for, against the same-context c=1 cell of the same matrix. Computed from the control alone, which is the point: the packed-path guard reads the adapter's counters and the control is unhooked, so only a hooked arm can be SEEN to fall off the batched path.",
  "cells": {
   "ctx128-c4": {
    "scale": 3.199,
    "concurrency": 4,
    "share_of_ideal": 0.8,
    "baseline_cell": "ctx128-c1"
   },
   "ctx4096-c4": {
    "scale": 1.145,
    "concurrency": 4,
    "share_of_ideal": 0.286,
    "baseline_cell": "ctx4096-c1"
   },
   "ctx16384-c4": {
    "scale": 1.32,
    "concurrency": 4,
    "share_of_ideal": 0.33,
    "baseline_cell": "ctx16384-c1"
   },
   "ctx128-c16": {
    "scale": 8.173,
    "concurrency": 16,
    "share_of_ideal": 0.511,
    "baseline_cell": "ctx128-c1"
   },
   "ctx4096-c16": {
    "scale": 2.615,
    "concurrency": 16,
    "share_of_ideal": 0.163,
    "baseline_cell": "ctx4096-c1"
   },
   "ctx128-c32": {
    "scale": 13.049,
